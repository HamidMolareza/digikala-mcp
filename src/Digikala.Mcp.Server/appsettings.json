{
  "ServerLogging": {
    "MinimumLevel": "Information",
    "AuditLogPath": "./app-data/logs/audit-.clef",
    "ErrorLogPath": "./app-data/logs/error-.clef",
    "EnableConsole": true
  },
  "Digikala": {
    "BaseUrl": "https://api.digikala.com",
    "FeaturesBaseUrl": "https://api-zakaria.digikala.com",
    "TimeoutSeconds": 10,
    "MaxRequestsPerSecond": 30,
    "DefaultWarehouseId": 29
  },
  "Cache": {
    "DatabasePath": "./app-data/cache.db",
    "LongTermTtlMinutes": 1440,
    "MediumTermTtlMinutes": 60,
    "ShortTermTtlMinutes": 5,
    "CleanupIntervalMinutes": 10
  }
}
